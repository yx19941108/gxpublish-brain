<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gxpublish.brain.editorial.mapper.EditorialWorkflowRoleMapper">

    <select id="selectRoleRefs" resultType="com.gxpublish.brain.editorial.domain.vo.EditorialWorkflowRoleRefVo">
        SELECT role_id,
               role_key
        FROM sys_role
        WHERE del_flag = '0'
          AND status = '0'
          AND role_key IN
        <foreach item="roleKey" collection="roleKeys" open="(" separator="," close=")">
            #{roleKey}
        </foreach>
    </select>

</mapper>
